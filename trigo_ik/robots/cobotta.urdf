<?xml version="1.0"?>
<!-- cobotta: kinematics only (joint frames, axes, limits), no meshes -->
<robot name="cobotta">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="flange"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-2.618" upper="2.618" effort="0" velocity="0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.0472" upper="1.7453" effort="0" velocity="0"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.165" rpy="0 0 0"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="0.3142" upper="2.4435" effort="0" velocity="0"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="-0.012 0.02 -0.345" rpy="0 0 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-2.9671" upper="2.9671" effort="0" velocity="0"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 -0.02 0.5225" rpy="0 0 0"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.6581" upper="2.3562" effort="0" velocity="0"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 -0.0445 0.042" rpy="0 0 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-2.9671" upper="2.9671" effort="0" velocity="0"/>
  </joint>
  <joint name="flange_joint" type="fixed">
    <parent link="link6"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
