<?xml version="1.0"?>
<!-- rs007l: kinematics only (joint frames, axes, limits), no meshes -->
<robot name="rs007l">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="flange"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.36" rpy="0 0 0"/>
    <axis xyz="0 0 -1.0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="0 -1.5707963267948966 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-2.3562" upper="2.3562" effort="0" velocity="0"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.455 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1.0"/>
    <limit lower="-2.7489" upper="2.7489" effort="0" velocity="0"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0925 0 0" rpy="0 1.5707963267948966 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-3.4907" upper="3.4907" effort="0" velocity="0"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.3825" rpy="0 -1.5707963267948966 0"/>
    <axis xyz="0 0 -1.0"/>
    <limit lower="-2.1817" upper="2.1817" effort="0" velocity="0"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.078 0 0" rpy="0 1.5707963267948966 0"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="-6.2832" upper="6.2832" effort="0" velocity="0"/>
  </joint>
  <joint name="flange_joint" type="fixed">
    <parent link="link6"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
